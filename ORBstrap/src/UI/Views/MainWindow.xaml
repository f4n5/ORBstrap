<Window x:Class="Crypt3d.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ORBstrap — Roblox Bootstrapper"
        Icon="pack://application:,,,/Resources/icon.ico"
        Height="640" Width="960"
        MinHeight="520" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#0F0F12"
        Foreground="#F3F4F6"
        FontFamily="Segoe UI"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <Style x:Key="NavButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Padding" Value="18,11,14,11"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2A35"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22222A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#7C3AED"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#25252B"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderBrush" Value="#374151"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1A1A1E"/>
            <Setter Property="Foreground" Value="#F3F4F6"/>
            <Setter Property="BorderBrush" Value="#374151"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="CaretBrush" Value="#A78BFA"/>
        </Style>
        <Style x:Key="DarkComboToggle" TargetType="ToggleButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ClickMode" Value="Press"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                                  Data="M 0 0 L 4 4 L 8 0" Stroke="#9CA3AF" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#7C3AED"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1A1A1E"/>
            <Setter Property="Foreground" Value="#F3F4F6"/>
            <Setter Property="BorderBrush" Value="#374151"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8,32,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Style="{StaticResource DarkComboToggle}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="#1A1A1E" BorderBrush="#374151" BorderThickness="1"
                                        CornerRadius="8" Margin="0,4,0,0" Padding="2">
                                    <ScrollViewer>
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2A35"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#7C3AED"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDEBAR -->
        <Border Grid.Column="0" Background="#16161A" BorderBrush="#25252B" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="16,20,16,24">
                    <TextBlock Text="ORBstrap" FontSize="22" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Roblox Bootstrapper" FontSize="11" Foreground="#6B7280" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="16,12,16,16">
                    <TextBlock Text="Powered by RoValra" FontSize="10" Foreground="#6B7280"/>
                    <TextBlock Text="rovalra.com" FontSize="10" Foreground="#7C3AED" Cursor="Hand"
                               MouseLeftButtonUp="RoValraLink_Click"/>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Margin="12,0,12,4" Padding="10" Background="#1C1C22" CornerRadius="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="AvatarEllipse" Grid.Column="0" Width="34" Height="34" Margin="0,0,10,0" Fill="#7C3AED"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtUserName" Text="—" FontWeight="SemiBold" FontSize="12.5"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="Verified ✔" FontSize="10.5" Foreground="#10B981"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <RadioButton x:Name="NavHome" Style="{StaticResource NavButton}" Content="Home / Launch"
                                     IsChecked="True" Checked="Nav_Checked" Tag="Home"/>
                        <RadioButton x:Name="NavFastFlags" Style="{StaticResource NavButton}" Content="FastFlags"
                                     Checked="Nav_Checked" Tag="FastFlags"/>
                        <RadioButton x:Name="NavMods" Style="{StaticResource NavButton}" Content="Textures"
                                     Checked="Nav_Checked" Tag="Mods"/>
                        <RadioButton x:Name="NavActivity" Style="{StaticResource NavButton}" Content="Activity &amp; Servers"
                                     Checked="Nav_Checked" Tag="Activity"/>
                        <RadioButton x:Name="NavGames" Style="{StaticResource NavButton}" Content="Games"
                                     Checked="Nav_Checked" Tag="Games"/>
                        <RadioButton x:Name="NavDiscord" Style="{StaticResource NavButton}" Content="Discord"
                                     Checked="Nav_Checked" Tag="Discord"/>
                        <RadioButton x:Name="NavCleaner" Style="{StaticResource NavButton}" Content="Cleaner"
                                     Checked="Nav_Checked" Tag="Cleaner"/>
                        <RadioButton x:Name="NavBehaviour" Style="{StaticResource NavButton}" Content="Behaviour"
                                     Checked="Nav_Checked" Tag="Behaviour"/>
                        <RadioButton x:Name="NavAppearance" Style="{StaticResource NavButton}" Content="Appearance"
                                     Checked="Nav_Checked" Tag="Appearance"/>
                        <RadioButton x:Name="NavAbout" Style="{StaticResource NavButton}" Content="About"
                                     Checked="Nav_Checked" Tag="About"/>
                    </StackPanel>
                </ScrollViewer>

            </DockPanel>
        </Border>

        <!-- CONTENT -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28,24,28,20">
            <!-- HOME -->
            <StackPanel x:Name="PanelHome" Visibility="Visible">
                <TextBlock x:Name="TxtWelcome" Text="¡Bienvenido!" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock Text="Launch Roblox with your ORBstrap settings applied." Foreground="#9CA3AF" Margin="0,0,0,20"/>
                <Border Background="#1C1C22" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Status" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock x:Name="StatusText" Text="Ready to launch" Foreground="#9CA3AF" TextWrapping="Wrap"/>
                        <Button x:Name="BtnLaunch" Content="Launch Roblox" Style="{StaticResource PrimaryBtn}"
                                HorizontalAlignment="Left" Margin="0,16,0,0" Click="LaunchButton_Click"/>
                    </StackPanel>
                </Border>
                <Border Background="#1C1C22" CornerRadius="12" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Quick toggles" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <CheckBox x:Name="ChkMultiInstance" Content="Multi-instance support" IsChecked="True"/>
                        <CheckBox x:Name="ChkActivityQuick" Content="Activity tracking" IsChecked="True" Click="ActivityToggle_Click"/>
                        <CheckBox x:Name="ChkRoValraQuick" Content="RoValra server info" IsChecked="True"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- FASTFLAGS -->
            <StackPanel x:Name="PanelFastFlags" Visibility="Collapsed">
                <TextBlock Text="FastFlags" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock Text="Edit client FastFlags (respect the official allowlist)." Foreground="#9CA3AF" Margin="0,0,0,16"/>
                <Border Background="#1C1C22" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <CheckBox x:Name="ChkUseFastFlags" Content="Enable FastFlags on launch" IsChecked="True"/>
                        <TextBlock Text="Common presets" FontWeight="SemiBold" Margin="0,12,0,8"/>
                        <WrapPanel>
                            <Button Content="FPS Unlock (240)" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,8" Click="PresetFps_Click"/>
                            <Button Content="Low Graphics" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,8" Click="PresetLowGfx_Click"/>
                            <Button Content="Clear All" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,8" Click="PresetClear_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <TextBlock Text="Custom flags (JSON)" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBox x:Name="TxtFastFlags" Height="180" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/>
                <Button Content="Save FastFlags" Style="{StaticResource PrimaryBtn}"
                        HorizontalAlignment="Left" Margin="0,12,0,0" Click="SaveFastFlags_Click"/>
            </StackPanel>

            <!-- TEXTURES -->
            <StackPanel x:Name="PanelMods" Visibility="Collapsed">
                <TextBlock Text="Custom textures" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock Text="Replace Roblox textures, sounds, cursors and fonts with your own." Foreground="#9CA3AF" Margin="0,0,0,16"/>
                <Border Background="#1C1C22" CornerRadius="12" Padding="20">
                    <StackPanel>
                        <CheckBox x:Name="ChkEnableMods" Content="Enable custom textures" IsChecked="True"/>
                        <TextBlock Text="Texture pack" FontWeight="SemiBold" Margin="0,12,0,8"/>
                        <WrapPanel>
                            <Button Content="Import pack (.zip)…" Style="{StaticResource SecondaryBtn}"
                                    Margin="0,0,8,8" Click="ImportTextures_Click"/>
                            <Button Content="Open folder" Style="{StaticResource SecondaryBtn}"
                                    Margin="0,0,8,8" Click="OpenModsFolder_Click"/>
                            <Button Content="Restore originals" Style="{StaticResource SecondaryBtn}"
                                    Margin="0,0,0,8" Click="RestoreTextures_Click"/>
                        </WrapPanel>
                        <TextBox x:Name="TxtModsPath" IsReadOnly="True" Margin="0,4,0,0"/>
                        <TextBlock x:Name="TxtTexturesStatus" Foreground="#A78BFA" TextWrapping="Wrap" Margin="0,12,0,0"/>
                        <TextBlock Text="Packs use the same layout as Roblox: content\textures\…, content\sounds\…, content\fonts\… They are applied every time you launch Roblox from ORBstrap."
                                   Foreground="#6B7280" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="Only files inside “content” are used and executables are ignored. “Restore originals” puts Roblox's original files back."
                                   Foreground="#6B7280" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ACTIVITY -->
            <StackPanel x:Name="PanelActivity" Visibility="Collapsed">
                <TextBlock Text="Activity &amp; Servers" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock Text="Live server info powered by RoValra." Foreground="#9CA3AF" Margin="0,0,0,16"/>
                <Border Background="#1C1C22" CornerRadius="12" Padding="20" Margin="0,0,0,12">
                    <StackPanel>
                        <CheckBox x:Name="ChkActivityTracking" Content="Enable activity tracking" IsChecked="True" Click="ActivityToggle_Click"/>
                        <CheckBox x:Name="ChkShowLocation" Content="Show server region" IsChecked="True"/>
                        <CheckBox x:Name="ChkShowUptime" Content="Show server uptime" IsChecked="True"/>
                        <CheckBox x:Name="ChkSubmitRoValra" Content="Submit server IDs to RoValra (helps public dataset)" IsChecked="True"/>
                    </StackPanel>
                </Border>
                <Border Background="#1C1C22" CornerRadius="12" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Current server" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock x:Name="TxtServerRegion" Text="Region: —" Foreground="#9CA3AF"/>
                        <TextBlock x:Name="TxtServerUptime" Text="Uptime: —" Foreground="#9CA3AF" Margin="0,4,0,0"/>
                        <TextBlock x:Name="TxtServerJobId" Text="JobId: —" Foreground="#6B7280" FontSize="11" Margin="0,8,0,0"
                                   FontFamily="Consolas"/>
                        <Button Content="Refresh (when in-game)" Style="{StaticResource SecondaryBtn}"
                                HorizontalAlignment="Left" Margin="0,14,0,0" Click="RefreshServer_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- GAMES -->
            <StackPanel x:Name="PanelGames" Visibility="Collapsed">
                <TextBlock Text="Games" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock Text="See what you're playing and jump into the best server." Foreground="#9CA3AF" Margin="0,0,0,16"/>

                <Border Background="#1C1C22" CornerRadius="12" Padding="20" Margin="0,0,0,12">
                    <StackPanel>
                        <CheckBox x:Name="ChkShowGames" Content="Show the game I'm playing and my recent games" IsChecked="True"/>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="GameIcon" Grid.Column="0" Width="64" Height="64" CornerRadius="10"
                                    Background="#2A2A35" Margin="0,0,16,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtGameName" Text="Not in a game" FontSize="17" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="TxtGameMeta" Text="Launch Roblox and join a game to see it here." Foreground="#9CA3AF"
                                           TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                        <Button x:Name="BtnUseCurrent" Content="Use this game below" Style="{StaticResource SecondaryBtn}"
                                HorizontalAlignment="Left" Margin="0,14,0,0" Visibility="Collapsed" Click="UseCurrentGame_Click"/>
                        <TextBlock Text="The game is detected from the Roblox log, so “Activity tracking” must be on (Activity &amp; Servers)."
                                   Foreground="#6B7280" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Background="#1C1C22" CornerRadius="12" Padding="20" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Join best server" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="Game (place ID or roblox.com/games/… link)" Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtJoinPlace"/>
                        <TextBlock Text="Pick the server with" Foreground="#9CA3AF" FontSize="12" Margin="0,12,0,6"/>
                        <ComboBox x:Name="CmbJoinMode" Width="220" HorizontalAlignment="Left"
                                  Background="#1A1A1E" Foreground="#F3F4F6" BorderBrush="#374151">
                            <ComboBoxItem Content="Best ping" Tag="ping" IsSelected="True"/>
                            <ComboBoxItem Content="Most players" Tag="players"/>
                            <ComboBoxItem Content="Balanced (ping + players)" Tag="balanced"/>
                        </ComboBox>
                        <Button x:Name="BtnJoinBest" Content="Join best server" Style="{StaticResource PrimaryBtn}"
                                HorizontalAlignment="Left" Margin="0,16,0,0" Click="JoinBest_Click"/>
                        <TextBlock x:Name="TxtJoinStatus" Foreground="#A78BFA" TextWrapping="Wrap" Margin="0,12,0,0"/>
                        <TextBlock Text="Full servers are skipped. Ping comes from Roblox's own server list and is an estimate. Your FastFlags and textures are applied before joining."
                                   Foreground="#6B7280" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Background="#1C1C22" CornerRadius="12" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Recent games" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <TextBlock x:Name="TxtNoRecent" Text="Games you play from ORBstrap will show up here. Click one to use it above."
                                   Foreground="#6B7280" FontSize="12" TextWrapping="Wrap"/>
                        <ItemsControl x:Name="LstRecentGames">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#25252B" CornerRadius="8" Padding="12,8" Margin="0,0,0,6" Cursor="Hand"
                                            Tag="{Binding PlaceId}" MouseLeftButtonUp="RecentGame_Click">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Subtitle}" Foreground="#9CA3AF" FontSize="11"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- DISCORD -->
            <StackPanel x:Name="PanelDiscord" Visibility="Collapsed">
                <TextBlock Text="Show in Discord" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock Text="The ORB bot posts in our Discord server when you're playing, so everyone can see." Foreground="#9CA3AF" Margin="0,0,0,16"/>
                <Border Background="#1C1C22" CornerRadius="12" Padding="20" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ProfileAvatar" Width="64" Height="64" Fill="#7C3AED" Margin="0,0,16,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TxtProfileName" Text="—" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtProfileId" Foreground="#6B7280" FontSize="11" Margin="0,2,0,0"/>
                            <TextBlock Text="Verified by the ORB bot ✔" Foreground="#10B981" FontSize="11.5" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Background="#1C1C22" CornerRadius="12" Padding="20">
                    <StackPanel>
                        <CheckBox x:Name="ChkDiscordRpc" Content="Show in Discord when I'm playing" IsChecked="False" Click="DiscordOptions_Click"/>
                        <CheckBox x:Name="ChkDiscordAccount" Content="Show my Discord name (otherwise it says “A player”)" IsChecked="False" Click="DiscordOptions_Click"/>
                        <CheckBox x:Name="ChkDiscordGame" Content="Show the game I'm in (otherwise it just says “Roblox”)" IsChecked="False" Click="DiscordOptions_Click"/>
                        <TextBlock Text="What others will see" FontWeight="SemiBold" Margin="0,6,0,4"/>
                        <TextBlock x:Name="TxtDiscordPreview" Foreground="#A78BFA" TextWrapping="Wrap"/>
                        <TextBlock Text="When Roblox starts, ORBstrap tells the ORB bot, which posts a message in the server. When Roblox closes, the message is removed. The game name is only sent if you turn on “Show the game I'm in”."
                                   Foreground="#6B7280" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- CLEANER -->
            <StackPanel x:Name="PanelCleaner" Visibility="Collapsed">
                <TextBlock Text="Cleaner" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock Text="Automatically remove old Roblox / ORBstrap data." Foreground="#9CA3AF" Margin="0,0,0,16"/>
                <Border Background="#1C1C22" CornerRadius="12" Padding="20">
                    <StackPanel>
                        <CheckBox x:Name="ChkEnableCleaner" Content="Enable cleaner on launch" IsChecked="True"/>
                        <TextBlock Text="Delete files older than" FontWeight="SemiBold" Margin="0,12,0,6"/>
                        <ComboBox x:Name="CmbCleanerDays" Width="160" HorizontalAlignment="Left"
                                  Background="#1A1A1E" Foreground="#F3F4F6" BorderBrush="#374151">
                            <ComboBoxItem Content="1 day" Tag="1"/>
                            <ComboBoxItem Content="7 days" Tag="7" IsSelected="True"/>
                            <ComboBoxItem Content="14 days" Tag="14"/>
                            <ComboBoxItem Content="30 days" Tag="30"/>
                            <ComboBoxItem Content="Never" Tag="0"/>
                        </ComboBox>
                        <TextBlock Text="What to clean" FontWeight="SemiBold" Margin="0,16,0,8"/>
                        <CheckBox x:Name="ChkCleanCache" Content="Roblox cache / downloads" IsChecked="True"/>
                        <CheckBox x:Name="ChkCleanLogs" Content="Roblox logs" IsChecked="True"/>
                        <CheckBox x:Name="ChkCleanCryptLogs" Content="ORBstrap logs" IsChecked="False"/>
                        <Button Content="Run cleaner now" Style="{StaticResource SecondaryBtn}"
                                HorizontalAlignment="Left" Margin="0,14,0,0" Click="RunCleaner_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- BEHAVIOUR -->
            <StackPanel x:Name="PanelBehaviour" Visibility="Collapsed">
                <TextBlock Text="Behaviour" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock Text="How ORBstrap and Roblox behave on launch." Foreground="#9CA3AF" Margin="0,0,0,16"/>
                <Border Background="#1C1C22" CornerRadius="12" Padding="20">
                    <StackPanel>
                        <CheckBox x:Name="ChkConfirmMulti" Content="Prompt when launching another instance" IsChecked="True"/>
                        <CheckBox x:Name="ChkBgUpdates" Content="Background updates" IsChecked="True"/>
                        <CheckBox x:Name="ChkDontExitDesktop" Content="Don't exit to Roblox desktop app" IsChecked="False"/>
                        <TextBlock Text="Channel" FontWeight="SemiBold" Margin="0,14,0,6"/>
                        <ComboBox x:Name="CmbChannel" Width="180" HorizontalAlignment="Left"
                                  Background="#1A1A1E" Foreground="#F3F4F6" BorderBrush="#374151">
                            <ComboBoxItem Content="LIVE" IsSelected="True"/>
                            <ComboBoxItem Content="ZBeta"/>
                            <ComboBoxItem Content="ZCanary"/>
                        </ComboBox>
                        <TextBlock Text="Custom Roblox domain (optional)" FontWeight="SemiBold" Margin="0,14,0,6"/>
                        <TextBox x:Name="TxtCustomDomain" Width="280" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- APPEARANCE -->
            <StackPanel x:Name="PanelAppearance" Visibility="Collapsed">
                <TextBlock Text="Appearance" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock Text="Theme and bootstrapper style." Foreground="#9CA3AF" Margin="0,0,0,16"/>
                <Border Background="#1C1C22" CornerRadius="12" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Theme" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ThemeDark" Content="Dark" IsChecked="True" GroupName="Theme" Margin="0,0,16,0"/>
                            <RadioButton x:Name="ThemeLight" Content="Light" GroupName="Theme" Margin="0,0,16,0" IsEnabled="False"/>
                            <RadioButton x:Name="ThemeSystem" Content="System" GroupName="Theme" IsEnabled="False"/>
                        </StackPanel>
                        <TextBlock Text="Bootstrapper style" FontWeight="SemiBold" Margin="0,18,0,8"/>
                        <ComboBox x:Name="CmbStyle" Width="200" HorizontalAlignment="Left" IsEnabled="False"
                                  Background="#1A1A1E" Foreground="#F3F4F6" BorderBrush="#374151">
                            <ComboBoxItem Content="Fluent" IsSelected="True"/>
                            <ComboBoxItem Content="Classic"/>
                            <ComboBoxItem Content="Minimal"/>
                            <ComboBoxItem Content="Terminal"/>
                        </ComboBox>
                        <TextBlock Text="Only the Dark theme and the Fluent style are available for now. Other options are coming in a future update."
                                   Foreground="#6B7280" FontSize="12" Margin="0,16,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ABOUT -->
            <StackPanel x:Name="PanelAbout" Visibility="Collapsed">
                <TextBlock Text="About ORBstrap" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock Text="v1.1.0 · with the ORB official bot" Foreground="#9CA3AF" Margin="0,0,0,20"/>
                <Border Background="#1C1C22" CornerRadius="12" Padding="20">
                    <StackPanel>
                        <TextBlock Text="ORBstrap is a modern Roblox bootstrapper inspired by Fishstrap and Bloxstrap, connected to the ORB official bot."
                                   TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <TextBlock Text="Server region and uptime data are provided by RoValra."
                                   TextWrapping="Wrap" Margin="0,0,0,4"/>
                        <TextBlock Text="Powered by RoValra  →  https://www.rovalra.com"
                                   Foreground="#A78BFA" Cursor="Hand" MouseLeftButtonUp="RoValraLink_Click"/>
                        <Separator Background="#374151" Margin="0,16"/>
                        <TextBlock Text="Logs &amp; settings" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Open Logs Folder" Style="{StaticResource SecondaryBtn}"
                                    Margin="0,0,8,0" Click="LogsButton_Click"/>
                            <Button Content="Open Settings Folder" Style="{StaticResource SecondaryBtn}"
                                    Click="SettingsFolder_Click"/>
                        </StackPanel>
                        <Separator Background="#374151" Margin="0,16"/>
                        <TextBlock Text="Account &amp; app" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Log out" Style="{StaticResource SecondaryBtn}"
                                    Margin="0,0,8,0" Click="Logout_Click"/>
                            <Button x:Name="BtnUninstall" Content="Uninstall ORBstrap…" Style="{StaticResource SecondaryBtn}"
                                    Visibility="Collapsed" Click="Uninstall_Click"/>
                        </StackPanel>
                        <TextBlock Text="Please respect Roblox and RoValra Terms of Service."
                                   Foreground="#6B7280" FontSize="12" Margin="0,16,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
        </ScrollViewer>
    </Grid>
</Window>
