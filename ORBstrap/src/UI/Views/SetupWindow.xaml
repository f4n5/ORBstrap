<Window x:Class="Crypt3d.UI.Views.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ORBstrap Setup"
        Icon="pack://application:,,,/Resources/icon.ico"
        Width="580" Height="690"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#0F0F12"
        Foreground="#F3F4F6"
        FontFamily="Segoe UI">

    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="ORBstrap" FontSize="28" FontWeight="Bold" Foreground="White"/>
            <TextBlock x:Name="TxtSubtitle" Text="Set up ORBstrap and install it on this PC."
                       Foreground="#9CA3AF" Margin="0,4,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Ubicación -->
                <Border Background="#1C1C22" CornerRadius="12" Padding="18" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Install location" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtDir" Grid.Column="0" Margin="0,0,8,0" VerticalContentAlignment="Center"/>
                            <Button Grid.Column="1" Content="Browse…" Style="{StaticResource SecondaryBtn}"
                                    Click="Browse_Click"/>
                        </Grid>
                        <TextBlock Text="ORBstrap is installed inside a folder named “ORBstrap”. No administrator rights needed."
                                   Foreground="#6B7280" FontSize="11.5" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Accesos directos -->
                <Border Background="#1C1C22" CornerRadius="12" Padding="18" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Shortcuts" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <CheckBox x:Name="ChkDesktop" Content="Create a desktop shortcut" IsChecked="True"/>
                        <CheckBox x:Name="ChkStartMenu" Content="Create a Start menu shortcut" IsChecked="True" Margin="0"/>
                    </StackPanel>
                </Border>

                <!-- Configuración inicial -->
                <Border Background="#1C1C22" CornerRadius="12" Padding="18" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Initial settings" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <CheckBox x:Name="ChkMulti" Content="Enable multi-instance (several Roblox windows)"/>
                        <CheckBox x:Name="ChkTextures" Content="Enable custom textures" IsChecked="True"/>
                        <CheckBox x:Name="ChkShowDiscord" Content="Show in Discord what I'm playing (via the ORB bot)" Margin="0"/>
                        <TextBlock Text="You can change all of this later inside the app."
                                   Foreground="#6B7280" FontSize="11.5" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <CheckBox x:Name="ChkLaunch" Content="Open ORBstrap when the installation finishes"
                          IsChecked="True" Margin="4,4,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <TextBlock x:Name="TxtStatus" Grid.Row="2" Margin="0,12,0,0" TextWrapping="Wrap"
                   Foreground="#9CA3AF" MinHeight="20"/>

        <!-- Botones -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BtnPortable" Grid.Column="0" Content="Run without installing"
                    Style="{StaticResource SecondaryBtn}" Click="Portable_Click"/>
            <Button x:Name="BtnCancel" Grid.Column="2" Content="Cancel" Margin="0,0,10,0"
                    Style="{StaticResource SecondaryBtn}" Click="Cancel_Click"/>
            <Button x:Name="BtnInstall" Grid.Column="3" Content="Install" MinWidth="110"
                    Style="{StaticResource PrimaryBtn}" Click="Install_Click"/>
        </Grid>
    </Grid>
</Window>
